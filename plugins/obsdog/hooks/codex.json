{
  "description": "Optional routing context; no transcript collection or knowledge writes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading ObsDog workflow guidance",
            "additionalContextLimit": 4096
          }
        ]
      }
    ]
  }
}
